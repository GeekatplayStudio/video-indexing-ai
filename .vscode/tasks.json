{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build solution",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"FootageSearch.sln"
			],
			"isBackground": false,
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		},
		{
			"label": "install plugin dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"install"
			],
			"options": {
				"cwd": "${workspaceFolder}/FootageSearch.ResolvePlugin"
			},
			"group": "build"
		},
		{
			"label": "start plugin",
			"type": "shell",
			"command": "npm",
			"args": [
				"start"
			],
			"options": {
				"cwd": "${workspaceFolder}/FootageSearch.ResolvePlugin"
			},
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Build App",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"FootageSearch.App/FootageSearch.App.csproj"
			],
			"isBackground": false,
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		},
		{
			"label": "Build App Full Path",
			"type": "shell",
			"command": "C:\\Program Files\\dotnet\\dotnet.exe",
			"args": [
				"build",
				"FootageSearch.App/FootageSearch.App.csproj"
			],
			"isBackground": false,
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		}
	]
}