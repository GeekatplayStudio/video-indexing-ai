<Window x:Class="FootageSearch.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About FootageSearch" Height="300" Width="400" 
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="FootageSearch" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
        <TextBlock Text="by Geekatplay Studio" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
        <TextBlock Text="Version 1.0.0" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,5"/>
        <TextBlock Text="© 2026 Geekatplay Studio" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="3" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20">
            A local media indexing application with AI-powered search capabilities.
            <LineBreak/>
            <LineBreak/>
            Integrated with DaVinci Resolve 20.
        </TextBlock>

        <Button Grid.Row="4" Content="OK" Width="80" Height="25" Click="OK_Click" HorizontalAlignment="Center" IsDefault="True"/>
    </Grid>
</Window>
