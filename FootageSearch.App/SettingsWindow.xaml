<Window x:Class="FootageSearch.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuration" Height="600" Width="600" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Configuration" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Watch Folders Section -->
        <GroupBox Header="Watch &amp; Search Paths" Grid.Row="1" Margin="0,0,0,10">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Margin="0,0,0,5">
                    <TextBlock Text="Available Drives:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="DrivesComboBox" Width="150" SelectionChanged="DrivesComboBox_SelectionChanged"/>
                    <Button Content="Add Drive Root" Click="AddDrive_Click" Margin="5,0,0,0" Padding="5,2"/>
                </StackPanel>

                <ListBox x:Name="WatchFoldersList" Grid.Row="1" Grid.Column="0" Margin="0,0,5,0"/>

                <StackPanel Grid.Row="1" Grid.Column="1">
                    <Button Content="Add Folder..." Click="AddFolder_Click" Margin="0,0,0,5" Padding="10,5"/>
                    <Button Content="Remove" Click="RemoveFolder_Click" Padding="10,5"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Temp Directory Section -->
        <GroupBox Header="Temporary Directory (Extracted Frames)" Grid.Row="2" Margin="0,0,0,10">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TempPathTextBox" IsReadOnly="True" VerticalAlignment="Center"/>
                <Button Content="Browse..." Grid.Column="1" Click="BrowseTemp_Click" Margin="5,0,0,0" Padding="10,5"/>
            </Grid>
        </GroupBox>

        <!-- AI Configuration Section -->
        <GroupBox Header="AI Configuration" Grid.Row="3" Margin="0,0,0,10">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Ollama URL:" VerticalAlignment="Center" Margin="0,0,10,5" Grid.Row="0" Grid.Column="0"/>
                <TextBox x:Name="OllamaUrlTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,5"/>

                <TextBlock Text="Ollama Model:" VerticalAlignment="Center" Margin="0,0,10,5" Grid.Row="1" Grid.Column="0"/>
                <TextBox x:Name="OllamaModelTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,5"/>

                <TextBlock Text="Embedding Model:" VerticalAlignment="Center" Margin="0,0,10,5" Grid.Row="2" Grid.Column="0"/>
                <TextBox x:Name="OllamaEmbeddingModelTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,5"/>

                <TextBlock Text="Whisper Model:" VerticalAlignment="Center" Margin="0,0,10,0" Grid.Row="3" Grid.Column="0"/>
                <ComboBox x:Name="WhisperModelComboBox" Grid.Row="3" Grid.Column="1">
                    <ComboBoxItem Content="Tiny"/>
                    <ComboBoxItem Content="Base"/>
                    <ComboBoxItem Content="Small"/>
                    <ComboBoxItem Content="Medium"/>
                    <ComboBoxItem Content="Large"/>
                </ComboBox>
            </Grid>
        </GroupBox>

        <!-- Action Buttons -->
        <StackPanel Orientation="Horizontal" Grid.Row="4" HorizontalAlignment="Right">
            <Button Content="Save &amp; Close" Click="Save_Click" Padding="15,5" Margin="0,0,10,0"/>
            <Button Content="Cancel" Click="Cancel_Click" Padding="15,5"/>
        </StackPanel>
    </Grid>
</Window>
