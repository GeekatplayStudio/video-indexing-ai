<Window x:Class="FootageSearch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FootageSearch - Geekatplay Studio" Height="600" Width="900"
        Icon="app_icon.png"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
    <DockPanel>
        <!-- Standard Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource {x:Static SystemColors.MenuBarBrushKey}}">
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Configuration..." Click="Settings_Click"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Re-Index Database" Click="ReIndex_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Documentation" Click="Documentation_Click"/>
                <Separator/>
                <MenuItem Header="_About FootageSearch" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <ToolBar Band="1" BandIndex="1">
                <Button Content="Settings" Click="Settings_Click"/>
                <Separator/>
                <Button Content="Re-Index" Click="ReIndex_Click"/>
                <Separator/>
                <CheckBox x:Name="SkipIndexedCheckBox" Content="Skip Indexed" IsChecked="True" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="Ready"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main Content Area -->
        <Grid Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search Bar -->
            <Grid Grid.Row="0" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Height="30" VerticalContentAlignment="Center" Padding="5,0" KeyDown="SearchBox_KeyDown"/>
                <Button Content="Search" Grid.Column="1" Width="80" Height="30" Margin="5,0,0,0" Click="Search_Click"/>
            </Grid>

            <!-- Results List -->
            <ListView x:Name="ResultsList" Grid.Row="1" Margin="10,0,10,10" BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="File Name" DisplayMemberBinding="{Binding FileName}" Width="250"/>
                        <GridViewColumn Header="Duration (s)" DisplayMemberBinding="{Binding DurationSeconds}" Width="80"/>
                        <GridViewColumn Header="Format" DisplayMemberBinding="{Binding Format}" Width="80"/>
                        <GridViewColumn Header="Resolution" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}x{1}">
                                                <Binding Path="Width"/>
                                                <Binding Path="Height"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Transcript" DisplayMemberBinding="{Binding Transcript}" Width="150"/>
                        <GridViewColumn Header="OCR" DisplayMemberBinding="{Binding OcrText}" Width="100"/>
                        <GridViewColumn Header="Visual Description" DisplayMemberBinding="{Binding VisualDescription}" Width="200"/>
                        <GridViewColumn Header="Path" DisplayMemberBinding="{Binding FilePath}" Width="300"/>
                    </GridView>
                </ListView.View>
            </ListView>
            
            <!-- Log Panel (Visible during indexing) -->
            <Grid x:Name="LogPanel" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Indexing Progress Log" FontWeight="Bold" Margin="0,0,0,5"/>
                <ListBox x:Name="LogList" Grid.Row="1" FontFamily="Consolas" FontSize="12"/>
            </Grid>
            
            <!-- Loading Overlay -->
            <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="#80000000">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Processing..." Foreground="White" FontSize="16" HorizontalAlignment="Center"/>
                    <ProgressBar x:Name="LoadingBar" Width="200" Height="20" IsIndeterminate="True" Margin="0,10,0,0"/>
                    <TextBlock x:Name="StatusText" Text="Initializing..." Foreground="White" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>